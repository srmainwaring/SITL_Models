<?xml version="1.0"?>
<!--
-->
<sdf version="1.9">
  <model name="helicopter">
    <link name="base_link">
      <inertial>
        <pose degrees="true">0.3625 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001670833</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.017608333</iyy>
          <iyz>0</iyz>
          <izz>0.019270833</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose degrees="true">0.2 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.2 0.24</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0e6</mu>
              <mu2>1.0e6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose degrees="true">0.15 0 0.05 90 0 -90</pose>
        <geometry>
          <mesh>
            <scale>1.75 1.75 1.75</scale>
            <uri>meshes/trex450_frame.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Sensors -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0.15 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <sensor name="range" type="gpu_lidar">
        <pose degrees="true">0.325 0 -0.03 0 90 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>1</visualize>
        <topic>range</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.01</min>
            <max>10</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <include>
      <uri>model://rotor_head_cw</uri>
      <name>rotor_head_cw</name>
      <pose degrees="true">0.15 0 0.23 0 0 13</pose>
    </include>
    <joint name="rotor_head_joint" type="fixed">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rotor_head_cw::base_link</child>
    </joint>

    <link name="tail_motor_link">
      <pose degrees="true">-0.605 0 0.075 90 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>5.9375E-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.9375E-06</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.015</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual_rotor_head">
        <pose degrees="true">0 0 -0.007 0 0 -60</pose>
        <geometry>
          <mesh>
            <scale>1.75 1.75 1.75</scale>
            <uri>meshes/trex450_tail_rotor_head.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="tail_motor_joint" type="revolute">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>tail_motor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="tail_blade_1_link">
      <pose relative_to="tail_blade_1_joint" degrees="true">0.067 0 0 0 180 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>3.46667E-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.70083E-06</iyy>
          <iyz>0</iyz>
          <izz>5.02083E-06</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.075 0.02 0.004</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose degrees="true">0.035 0 0 -90 0 -90</pose>
        <geometry>
          <mesh>
            <scale>1.75 1.75 1.75</scale>
            <uri>meshes/trex450_tail_blade.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="tail_blade_1_joint" type="revolute">
      <pose relative_to="tail_motor_link" degrees="true">0 0 0.05225 0 0 0</pose>
      <parent>tail_motor_link</parent>
      <child>tail_blade_1_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.10471975</lower>
          <upper>0.10471975</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="tail_blade_2_link">
      <pose relative_to="tail_blade_2_joint" degrees="true">0.067 0 0 0 180 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>3.46667E-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.70083E-06</iyy>
          <iyz>0</iyz>
          <izz>5.02083E-06</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.075 0.02 0.004</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose degrees="true">0.035 0 0 -90 0 -90</pose>
        <geometry>
          <mesh>
            <scale>1.75 1.75 1.75</scale>
            <uri>meshes/trex450_tail_blade.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="tail_blade_2_joint" type="revolute">
      <pose relative_to="tail_motor_link" degrees="true">0 0 0.05225 0 0 180</pose>
      <parent>tail_motor_link</parent>
      <child>tail_blade_2_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.10471975</lower>
          <upper>0.10471975</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- plugins -->
    <plugin name="gz::sim::systems::JointStatePublisher"
        filename="gz-sim-joint-state-publisher-system">
    </plugin>

    <plugin name="gz::sim::systems::JointController"
      filename="gz-sim-joint-controller-system">
      <joint_name>tail_motor_joint</joint_name>
      <initial_velocity>0.0</initial_velocity>
      <use_force_commands>1</use_force_commands>
      <use_actuator_msg>0</use_actuator_msg>
      <disable_braking>1</disable_braking>
      <p_gain>0.02</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
      <cmd_offset>0</cmd_offset>
    </plugin>

    <!-- tail rotor lift NACA 0012 -->
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <!-- <alpha_stall>0.2</alpha_stall> -->
      <alpha_stall>1.0</alpha_stall>
      <cla>6.1</cla>
      <cda>0.18</cda>
      <cma>0.0</cma>
      <cla_stall>-5.0</cla_stall>
      <cda_stall>1.1</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>tail_blade_1_link</link_name>
      <reversible>1</reversible>
      <visualize_forces>
        <visualize>1</visualize>
        <update_rate>1000</update_rate>
        <!-- Disabled - impacts performance at high rate needed for analysis -->
        <!-- <topic>/model/rotor_head_ccw/link/tail_blade_1_link/forces/lift_drag</topic> -->
      </visualize_forces>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <!-- <alpha_stall>0.2</alpha_stall> -->
      <alpha_stall>1.0</alpha_stall>
      <cla>6.1</cla>
      <cda>0.18</cda>
      <cma>0.0</cma>
      <cla_stall>-5.0</cla_stall>
      <cda_stall>1.1</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>tail_blade_2_link</link_name>
      <reversible>1</reversible>
      <visualize_forces>
        <visualize>1</visualize>
        <update_rate>1000</update_rate>
        <!-- Disabled - impacts performance at high rate needed for analysis -->
        <!-- <topic>/model/rotor_head_ccw/link/tail_blade_2_link/forces/lift_drag</topic> -->
      </visualize_forces>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>

      <!-- Frame conventions
        Require by ArduPilot: change model and gazebo from XYZ to XY-Z coordinates
      -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>base_link::imu_sensor</imuName>

      <!--
        FRAME_CLASS      6 (Heli)
        FRAME_TYPE       1 (X)
      -->

      <!--
        SERVO8_FUNCTION 31 (HeliRSC)
      -->
      <control channel="7">
        <jointName>rotor_head_cw::main_joint</jointName>
        <multiplier>500</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/rotor_head_cw/joint/main_joint/cmd_vel</cmd_topic>
      </control>

      <!--
        SERVO4_FUNCTION 36 (Motor4)
      -->
      <control channel="3">
        <jointName>tail_motor_joint</jointName>
        <multiplier>-1600</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/helicopter/joint/tail_motor_joint/cmd_vel</cmd_topic>
      </control>
      
      <!--
        SERVO1_FUNCTION 33 (Motor1)
      -->
      <control channel="0">
        <jointName>rotor_head_cw::servo_arm_1_joint</jointName>
        <multiplier>0.04</multiplier>
        <offset>-0.5</offset>
        <servo_max>2000</servo_max>
        <servo_min>1000</servo_min>
        <type>COMMAND</type>
        <cmd_topic>/model/rotor_head_cw/joint/servo_arm_1_joint/0/cmd_pos</cmd_topic>
      </control>

      <!--
        SERVO2_FUNCTION 34 (Motor2)
      -->
      <control channel="1">
        <jointName>rotor_head_cw::servo_arm_2_joint</jointName>
        <multiplier>0.04</multiplier>
        <offset>-0.5</offset>
        <servo_max>2000</servo_max>
        <servo_min>1000</servo_min>
        <type>COMMAND</type>
        <cmd_topic>/model/rotor_head_cw/joint/servo_arm_2_joint/0/cmd_pos</cmd_topic>
      </control>

      <!--
        SERVO3_FUNCTION 35 (Motor3)
      -->
      <control channel="2">
        <jointName>rotor_head_cw::servo_arm_3_joint</jointName>
        <multiplier>0.04</multiplier>
        <offset>-0.5</offset>
        <servo_max>2000</servo_max>
        <servo_min>1000</servo_min>
        <type>COMMAND</type>
        <cmd_topic>/model/rotor_head_cw/joint/servo_arm_3_joint/0/cmd_pos</cmd_topic>
      </control>

      <!-- Range sensor -->
      <!-- 
        Types
        =====
        May use the same type identifier as used in the sensor SDF element:
        http://sdformat.org/spec?ver=1.7&elem=sensor. We use `range` below as
        it is a standard topic name used in ROS for range sensors.

        Topics
        ======
        If a <topic> is specified in the <sensor> element, it is used.
        Otherwise the default topic will be prefixed with the world, model,
        and link names:

        /world/{world_name}/model/{model_name}/link/{link_name}/sensor/scan

        e.g. /world/empty/model/helicopter/link/base_link/sensor/range/scan

        Index
        =====
        The <sensor><type> and <sensor><index> elements are used
        to associate the sensor with the ArduPilot parameter group that
        defines the sensor properties such as its position and orientation
        in the frame.
      -->
      <!-- 
        RNGFND1_TYPE = 100 (SITL)
        RNGFND1_FUNCTION = 0 (LINEAR)
        RNGFND1_MIN = 0.1 (m)
        RNGFND1_MAX = 10.0 (m)
        RNGFND1_POS_X = 0.325
        RNGFND1_POS_Y = 0.0
        RNGFND1_POS_Z = -0.325
        RNGFND1_ORIENT = 25 (Down)
      -->
      <sensor>
        <type>range</type>
        <index>1</index>
        <topic>range</topic>
      </sensor>

    </plugin>
  </model>

</sdf>