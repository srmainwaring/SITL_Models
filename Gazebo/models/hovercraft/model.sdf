    <joint name="motor_back_joint" type="revolute">
      <pose relative_to="base_link" degrees="true">-0.057 0.0 0.009 0 0 0</pose>
      <parent>base_link</parent>
      <child>motor_back_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
