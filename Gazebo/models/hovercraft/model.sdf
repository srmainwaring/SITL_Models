<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hovercraft">
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.002356667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005996667</iyy>
          <iyz>0</iyz>
          <izz>0.008306667</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.2 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <!-- <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.2 0.03</size>
          </box>
        </geometry> -->
        <pose>0 0 0 0 0 0</pose>
        <geometry>
        <mesh>
            <uri>models://hovercraft/meshes/hovercraft.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5</ambient>
          <diffuse>0.5 0.5 0.5</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <pbr>
            <metal>
              <metalness>0.2</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

    </link>

    <link name="motor_left_link">
      <pose relative_to="motor_left_joint">0 0 0.008 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="prop_collision">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5</ambient>
          <diffuse>0.5 0.5 0.5</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="prop_visual">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0007 0.0007 0.0007</scale>
            <uri>model://hovercraft/meshes/prop_triblade_5045_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 1 0</ambient>
          <diffuse>0 1 0</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="motor_left_joint" type="revolute">
      <pose relative_to="base_link" degrees="true">-0.132 0.0507 0.0935 0 90 0</pose>
      <parent>base_link</parent>
      <child>motor_left_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.002</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name="motor_right_link">
      <pose relative_to="motor_right_joint">0 0 0.008 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="prop_collision">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5</ambient>
          <diffuse>0.5 0.5 0.5</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="prop_visual">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0007 0.0007 0.0007</scale>
            <uri>model://hovercraft/meshes/prop_triblade_5045_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1</ambient>
          <diffuse>0 0 1</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="motor_right_joint" type="revolute">
      <pose relative_to="base_link" degrees="true">-0.132 -0.0507 0.0935 0 90 0</pose>
      <parent>base_link</parent>
      <child>motor_right_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.002</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name="motor_front_link">
      <pose relative_to="motor_front_joint">0 0 0.008 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="prop_collision">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5</ambient>
          <diffuse>0.5 0.5 0.5</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="prop_visual">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0007 0.0007 0.0007</scale>
            <uri>model://hovercraft/meshes/prop_triblade_5045_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1</ambient>
          <diffuse>0 0 1</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="motor_front_joint" type="revolute">
      <pose relative_to="base_link" degrees="true">0.067 0.0 0.009 0 0 0</pose>
      <parent>base_link</parent>
      <child>motor_front_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
