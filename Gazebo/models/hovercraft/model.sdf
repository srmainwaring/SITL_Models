        <dynamics>
          <damping>0.002</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- plugins -->
    <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
    </plugin>

    <!-- prop_left (cw) lift-drag (ArduPilot throttle left) -->
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>0.063 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_left_link</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>-0.0315 0.0545596 0</cp>
      <forward>0.866025404 0.5 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_left_link</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>-0.0315 -0.0545596 0</cp>
      <forward>-0.866025404 0.5 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_left_link</link_name>
    </plugin>

    <!-- prop_right (ccw) lift-drag (ArduPilot throttle right) -->
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>0.063 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_right_link</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>-0.0315 0.0545596 0</cp>
      <forward>-0.866025404 -0.5 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_right_link</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <reversible>1</reversible>
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.0015</area>
      <air_density>1.2041</air_density>
      <cp>-0.0315 -0.0545596 0</cp>
      <forward>0.866025404 -0.5 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_right_link</link_name>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Connection -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transforms -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>base_link::imu_sensor</imuName>

      <!-- 
          SERVO1_FUNCTION   73 (ThrottleLeft)
       -->
      <control channel="0">
        <jointName>motor_left_joint</jointName>
        <!-- <multiplier>-1500</multiplier> -->
        <multiplier>-1000</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>-1</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- 
          SERVO2_FUNCTION   74 (ThrottleRight)
       -->
      <control channel="1">
        <jointName>motor_right_joint</jointName>
        <!-- <multiplier>1500</multiplier> -->
        <multiplier>1000</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>-1</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- 
          SERVO3_FUNCTION   56 (RCIN8)
       -->
      <control channel="2">
        <jointName>motor_front_joint</jointName>
        <multiplier>1</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>-1</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- 
          SERVO4_FUNCTION   56 (RCIN8)
       -->
      <control channel="3">
        <jointName>motor_back_joint</jointName>
        <multiplier>-1</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <useForce>1</useForce>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>-1</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

    </plugin>

  </model>
</sdf>
