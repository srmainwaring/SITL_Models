    <link name="motor_back_link">
      <pose relative_to="motor_back_joint">0 0 0.008 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name="prop_collision">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5</ambient>
          <diffuse>0.5 0.5 0.5</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="prop_visual">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0007 0.0007 0.0007</scale>
            <uri>model://hovercraft/meshes/prop_triblade_5045_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 1 0</ambient>
          <diffuse>0 1 0</diffuse>
          <specular>0.5 0.5 0.5</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
