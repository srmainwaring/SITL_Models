<?xml version="1.0"?>
<sdf version="1.9">
  <model name="omniquad">
    <link name="base_link">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.333</iyy>
          <iyz>0</iyz>
          <izz>0.333</izz>
        </inertia>
      </inertial>
      <collision name="frame_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.3</size>
          </box>
        </geometry>
      </collision>
      <visual name="frame_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omniquad/meshes/frame_sm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0 0</ambient>
          <diffuse>1 0 0</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="frame_bottom_visual">
        <pose degrees="true">0 0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://omniquad/meshes/frame-bottom.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0 0</ambient>
          <diffuse>1 0 0</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
