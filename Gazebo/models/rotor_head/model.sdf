<!--
Blender > Export > Collada > Forward axis: +Z, Up axis: +X


FreeCAD positions of swashplate joints

blade grip couplings
1. [-22.52 mm  -68.00 mm  0.40 mm]
2. [22.52 mm  -68.00 mm  -0.40 mm]

lever couplings
1. [0.40 mm  -68.00 mm  22.52 mm]
2. [-0.40 mm  -68.00 mm  -22.52 mm]


Closed kinematic chains in gz-sim
https://github.com/oKermorgant/gz_attach_links

-->
<sdf version="1.9">
  <model name="rotor_head">
    <!-- base included for testing -->
    <link name="base_link">
      <pose degrees="true">0 0 -0.2 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>10</mass>
        <inertia>
          <ixx>0.004166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.004166667</iyy>
          <iyz>0</iyz>
          <izz>0.004166667</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2</ambient>
          <diffuse>0.2 0.2 0.2</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="main_joint" type="revolute">
      <parent>base_link</parent>
      <child>main_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="main_link">
      <inertial>
