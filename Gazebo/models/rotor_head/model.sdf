<?xml version="1.0"?>
<!--
Blender > Export > Collada > Forward axis: +Z, Up axis: +X
-->
<sdf version="1.9">
  <model name="rotor_head">
    <!-- base included for testing -->
    <link name="base_link">
      <pose degrees="true">0 0 -0.2 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>10</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2</ambient>
          <diffuse>0.2 0.2 0.2</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="main_joint" type="revolute">
      <parent>base_link</parent>
      <child>main_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="main_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/rotor_head_v2.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual_main_body">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/rotor_head_v2.dae</uri>
            <submesh>
