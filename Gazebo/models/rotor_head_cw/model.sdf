    <!-- rotor blades:
      pose.x = 0.200 => hinge is 0.225mm - 0.200mm = 0.0250mm from hub
      pose.x = 0.165 => hinge is 0.225mm - 0.165mm = 0.0625mm from hub
    -->
    <link name="blade_1_link">
      <pose relative_to="blade_grip_1_link" degrees="true">-0.225 0 0 0 0 0</pose>
      <inertial>
        <mass>0.045</mass>
        <inertia>
          <ixx>4.04378E-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000396177</iyy>
          <iyz>0</iyz>
          <izz>0.000400055</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.325 0.0325 0.0047</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose degrees="true">0.17 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/rotor_blade.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Leave marker for debugging lift-drag plugin
      <visual name="cp_visual">
        <pose>-0.0625 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.01</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0 0</ambient>
          <diffuse>1 0 0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual> -->
    </link>
    <joint name="blade_1_joint" type="revolute">
      <pose degrees="true">0.2 0 0 0 0 0</pose>
      <parent>blade_grip_1_link</parent>
      <child>blade_1_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.13962634</lower>
          <upper>0.13962634</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <spring_reference>0</spring_reference>
          <spring_stiffness>1.0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="blade_2_link">
      <pose relative_to="blade_grip_2_link" degrees="true">0.225 0 0 0 0 180</pose>
