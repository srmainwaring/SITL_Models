    <plugin name="gz::sim::systems::JointStatePublisher"
        filename="gz-sim-joint-state-publisher-system">
    </plugin>

    <plugin name="gz::sim::systems::JointController"
      filename="gz-sim-joint-controller-system">
      <joint_name>main_joint</joint_name>
      <initial_velocity>0.0</initial_velocity>
      <use_force_commands>1</use_force_commands>
      <use_actuator_msg>0</use_actuator_msg>
      <disable_braking>1</disable_braking>
      <p_gain>0.2</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.0001</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
      <cmd_offset>0</cmd_offset>
    </plugin>

    <plugin name="gz::sim::systems::JointPositionController"
      filename="gz-sim-joint-position-controller-system">
      <joint_name>servo_arm_1_joint</joint_name>
      <topic>/model/rotor_head_cw/joint/servo_arm_1_joint/0/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <use_velocity_commands>0</use_velocity_commands>
      <p_gain>1e4</p_gain>
      <i_gain>2e3</i_gain>
      <d_gain>1</d_gain>
      <i_max>1e4</i_max>
      <i_min>-1e4</i_min>
      <cmd_max>1e4</cmd_max>
      <cmd_min>-1e4</cmd_min>
    </plugin>

    <plugin name="gz::sim::systems::JointPositionController"
