    <!-- rotor lift NACA 0012 -->
    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <alpha_stall>0.2</alpha_stall>
      <cla>6.1</cla>
      <cda>0.18</cda>
      <cma>0.0</cma>
      <cla_stall>-5.0</cla_stall>
      <cda_stall>1.1</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.011</area>
      <air_density>1.2041</air_density>
      <cp>-0.0625 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>blade_1_link</link_name>
      <visualize_forces>
        <visualize>1</visualize>
        <!-- <update_rate>1000</update_rate> -->
        <!-- Disabled - impacts performance at high rate needed for analysis -->
        <!-- <topic>/model/rotor_head_cw/link/blade_1_link/forces/lift_drag</topic> -->
      </visualize_forces>
    </plugin>

    <plugin name="gz::sim::systems::LiftDrag"
      filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <alpha_stall>0.2</alpha_stall>
      <cla>6.1</cla>
      <cda>0.18</cda>
      <cma>0.0</cma>
      <cla_stall>-5.0</cla_stall>
      <cda_stall>1.1</cda_stall>
      <cma_stall>0.0</cma_stall>
