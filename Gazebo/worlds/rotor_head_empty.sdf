<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty">
    <!--
      Physics configuration:
      - https://gazebosim.org/api/sim/8/physics.html


      Notes:
      
      dart
        - what settings are available in the library?
          - timeStep
          - constraintSolver

          - gz-physics/dartsim/src/JointFeatures.cc > ::AttachFixedJoint

          //! @todo hardcoded joint ERP and CFM.
          // These apply to all DynamicJointConstaints
          double erp = 1.0e-1;
          double cfm = 1.0e-6;
          gzdbg << "DynamicJointConstraint: erp: " << erp 
                << ", cfm: " << cfm << std::endl;
          constraint->setErrorReductionParameter(erp);
          constraint->setConstraintForceMixing(cfm);

      bullet
        - not properly supported
        - missing joint velocity features

      bullet_featherstone
        - unstable with step size 0.0001

    -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>-1.0</real_time_factor>
      <dart>
        <solver>
          <solver_type>dantzig</solver_type> 
          <!-- <solver_type>pgs</solver_type> -->
        </solver>
        <!-- <collision_detector>bullet</collision_detector> -->
        <!-- <collision_detector>dart</collision_detector> -->
        <!-- <collision_detector>fcl</collision_detector> -->
        <collision_detector>ode</collision_detector>
      </dart>
      <bullet>
        <solver>
          <type>sequential_impulse</type>
          <min_step_size>0.0001</min_step_size>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.2</cfm>
          <contact_surface_layer>0.001</contact_surface_layer>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
        <!-- <filename>gz-physics-bullet-plugin</filename> -->
        <!-- <filename>gz-physics-bullet-featherstone-plugin</filename> -->
      </engine>
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <spherical_coordinates>
      <latitude_deg>37.523648</latitude_deg>
      <longitude_deg>-122.255122</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="runway">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2</ambient>
            <diffuse>0.2 0.2 0.2</diffuse>
            <specular>0.1 0.1 0.1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ENU axes -->
    <!-- <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
